# ================================================================
# ValliGuard API - Environment Configuration
# ================================================================
# Copy this file to .env and fill in your values
# ================================================================

# ── Model Configuration ────────────────────────────────────────
# Choose which inference backend to use:
# - false: Use local joblib model (default)
# - true: Use AWS SageMaker endpoint

USE_SAGEMAKER=false

# ── SageMaker Configuration (if USE_SAGEMAKER=true) ────────────
# Get endpoint name from AWS SageMaker console
# Format: training-job-name-YYYY-MM-DD-HH-MM-SS-XXX

SAGEMAKER_ENDPOINT_NAME=paysim-xgb-2026-06-04-17-31-22-321

# AWS region where your SageMaker endpoint is deployed
AWS_REGION=ap-south-1

# ── AWS Credentials (optional) ──────────────────────────────────
# If not configured here, ensure ~/.aws/credentials is set up
# Or use: aws configure

AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ── API Configuration ──────────────────────────────────────────
# Host and port for FastAPI server

API_HOST=0.0.0.0
API_PORT=8001

# ── Logging Configuration ──────────────────────────────────────

LOG_LEVEL=INFO
